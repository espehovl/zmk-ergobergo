#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>
#include <physical_layouts.dtsi>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;

        row-gpios
            = <&xiao_d  8 GPIO_ACTIVE_HIGH>
            , <&xiao_d  7 GPIO_ACTIVE_HIGH>
            , <&xiao_d 13 GPIO_ACTIVE_HIGH>
            , <&xiao_d 14 GPIO_ACTIVE_HIGH>
            , <&xiao_d  3 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                     RC(0,6)  RC(0,7)  RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                     RC(1,6)  RC(1,7)  RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                     RC(2,6)  RC(2,7)  RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)             RC(4,7) RC(3,6)  RC(3,7)  RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                            RC(4,0) RC(4,1) RC(4,2)     RC(4,9) RC(4,10) RC(4,11)
                                                            RC(4,3)     RC(4,8)
        >;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        /* Right overlay selects this half; firmware still instantiates node on central config. */
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };

    leds {
        compatible = "gpio-leds";

        caps_lock_led: caps_lock_led {
            gpios = <&xiao_d 2 GPIO_ACTIVE_HIGH>;
        };
    };

    indicators: indicators {
        compatible = "zmk,indicator-leds";

        caps_lock_indicator: caps_lock {
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            leds = <&caps_lock_led>;
        };
    };

    /* Physical layout for ZMK Studio. Order MUST match default_transform.map above.
     * Units are centi-keyunits (1u = 100). 6 cols per half with a 150-unit gap between
     * halves, 4 main rows, 1 middle thumb on row 3, 6 outer thumbs on row 4, 2 inner
     * thumbs on row 5. Geometry is a reasonable approximation; tweak to taste. */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;

        keys  //                          w    h     x    y rot rx ry
            /* Row 0 */
            = <&key_physical_attrs 100 100    0    0  0 0 0>
            , <&key_physical_attrs 100 100  100    0  0 0 0>
            , <&key_physical_attrs 100 100  200    0  0 0 0>
            , <&key_physical_attrs 100 100  300    0  0 0 0>
            , <&key_physical_attrs 100 100  400    0  0 0 0>
            , <&key_physical_attrs 100 100  500    0  0 0 0>

            , <&key_physical_attrs 100 100 1000    0  0 0 0>
            , <&key_physical_attrs 100 100 1100    0  0 0 0>
            , <&key_physical_attrs 100 100 1200    0  0 0 0>
            , <&key_physical_attrs 100 100 1300    0  0 0 0>
            , <&key_physical_attrs 100 100 1400    0  0 0 0>
            , <&key_physical_attrs 100 100 1500    0  0 0 0>

            /* Row 1 */
            , <&key_physical_attrs 100 100    0  100  0 0 0>
            , <&key_physical_attrs 100 100  100  100  0 0 0>
            , <&key_physical_attrs 100 100  200  100  0 0 0>
            , <&key_physical_attrs 100 100  300  100  0 0 0>
            , <&key_physical_attrs 100 100  400  100  0 0 0>
            , <&key_physical_attrs 100 100  500  100  0 0 0>

            , <&key_physical_attrs 100 100 1000  100  0 0 0>
            , <&key_physical_attrs 100 100 1100  100  0 0 0>
            , <&key_physical_attrs 100 100 1200  100  0 0 0>
            , <&key_physical_attrs 100 100 1300  100  0 0 0>
            , <&key_physical_attrs 100 100 1400  100  0 0 0>
            , <&key_physical_attrs 100 100 1500  100  0 0 0>

            /* Row 2 */
            , <&key_physical_attrs 100 100    0  200  0 0 0>
            , <&key_physical_attrs 100 100  100  200  0 0 0>
            , <&key_physical_attrs 100 100  200  200  0 0 0>
            , <&key_physical_attrs 100 100  300  200  0 0 0>
            , <&key_physical_attrs 100 100  400  200  0 0 0>
            , <&key_physical_attrs 100 100  500  200  0 0 0>

            , <&key_physical_attrs 100 100 1000  200  0 0 0>
            , <&key_physical_attrs 100 100 1100  200  0 0 0>
            , <&key_physical_attrs 100 100 1200  200  0 0 0>
            , <&key_physical_attrs 100 100 1300  200  0 0 0>
            , <&key_physical_attrs 100 100 1400  200  0 0 0>
            , <&key_physical_attrs 100 100 1500  200  0 0 0>

            /* Row 3 — left half, middle thumb (RC(4,7)), right half */
            , <&key_physical_attrs 100 100    0  300  0 0 0>
            , <&key_physical_attrs 100 100  100  300  0 0 0>
            , <&key_physical_attrs 100 100  200  300  0 0 0>
            , <&key_physical_attrs 100 100  300  300  0 0 0>
            , <&key_physical_attrs 100 100  400  300  0 0 0>
            , <&key_physical_attrs 100 100  500  300  0 0 0>

            , <&key_physical_attrs 100 100  900  300  0 0 0>
            , <&key_physical_attrs 100 100 1000  300  0 0 0>
            , <&key_physical_attrs 100 100 1100  300  0 0 0>
            , <&key_physical_attrs 100 100 1200  300  0 0 0>
            , <&key_physical_attrs 100 100 1300  300  0 0 0>
            , <&key_physical_attrs 100 100 1400  300  0 0 0>
            , <&key_physical_attrs 100 100 1500  300  0 0 0>

            /* Row 4 — outer thumb cluster (3 per side) */
            , <&key_physical_attrs 100 100  400  400  0 0 0>
            , <&key_physical_attrs 100 100  500  400  0 0 0>
            , <&key_physical_attrs 100 100  600  400  0 0 0>

            , <&key_physical_attrs 100 100  900  400  0 0 0>
            , <&key_physical_attrs 100 100 1000  400  0 0 0>
            , <&key_physical_attrs 100 100 1100  400  0 0 0>

            /* Row 5 — inner thumbs (BLUE / RED) */
            , <&key_physical_attrs 100 100  600  500  0 0 0>

            , <&key_physical_attrs 100 100  900  500  0 0 0>
            ;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };
};
